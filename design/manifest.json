  "libraries": [],
  "components": [
    {
      "name": "Avatar",
      "group": "Identity",
      "summary": "사람을 나타내는 원형 사진 자리. 사진이 없으면 이름 첫 글자를 넣는다."
    },
    {
      "name": "Badge",
      "group": "Status",
      "summary": "행이나 카드의 상태를 한 단어로 보여 주는 표시다."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "화면에서 누르는 동작은 모두 cl-btn 하나에 종류와 크기를 붙여 만든다."
    },
    {
      "name": "Chart",
      "group": "Dashboard",
      "summary": "대시보드 막대 그래프(로그인 현황, 학습 시간대, 트래픽, 저장량)."
    },
    {
      "name": "Chip",
      "group": "Filters",
      "summary": "여러 값 중 하나로 목록을 거를 때 쓰는 알약 모양 버튼이다."
    },
    {
      "name": "Dialog",
      "group": "Overlays",
      "summary": "흐름을 멈추고 확인을 받거나 짧은 입력을 받는 창."
    },
    {
      "name": "Empty",
      "group": "Status",
      "summary": "목록이나 구역에 보여 줄 것이 없을 때 그 자리를 채운다."
    },
    {
      "name": "Field",
      "group": "Forms",
      "summary": "폼 입력 한 칸: 이름표, 입력 칸, 도움말 또는 오류."
    },
    {
      "name": "Menu",
      "group": "Overlays",
      "summary": "버튼을 누르면 뜨는 동작 목록(행 메뉴 ⋯, 계정 메뉴, 새로 만들기, 엑셀 메뉴)."
    },
    {
      "name": "MobileCard",
      "group": "Data",
      "summary": "900px 이하에서 표(cl-table)가 바뀌는 카드형 행. 따로 만드는 컴포넌트가 아니라 같은 표 마크업이 CSS로 바뀐다."
    },
    {
      "name": "NeedsList",
      "group": "Dashboard",
      "summary": "대시보드 '확인 필요': 관리자가 지금 처리할 일을 상태 순서로 모은 목록."
    },
    {
      "name": "PageHead",
      "group": "Layout",
      "summary": "화면 맨 위: 상위 메뉴, 제목, 화면 단위 버튼, 설명."
    },
    {
      "name": "Pagination",
      "group": "Navigation",
      "summary": "목록 아래 쪽 번호."
    },
    {
      "name": "Progress",
      "group": "Status",
      "summary": "진도율처럼 0~100% 값을 막대로 보여 준다."
    },
    {
      "name": "Segmented",
      "group": "Filters",
      "summary": "같은 목록을 다르게 보는 두세 가지 방식 중 하나를 고른다. 표/카드 보기, 대시보드 기간(오늘 · 7일 · 30일)에 쓴다."
    },
    {
      "name": "SelectionBar",
      "group": "Data",
      "summary": "표에서 행을 고르면 화면 아래에 떠서 고른 행에 할 일을 보여 준다."
    },
    {
      "name": "Sidebar",
      "group": "Layout",
      "summary": "작업공간 왼쪽 메뉴. 메뉴 검색, 묶음 이름, 메뉴 항목, 아래 바로가기."
    },
    {
      "name": "StatStrip",
      "group": "Dashboard",
      "summary": "대시보드 맨 위 숫자 띠. 핵심 숫자 여섯 개를 한 줄에 둔다."
    },
    {
      "name": "Table",
      "group": "Data",
      "summary": "여러 행을 같은 칸으로 비교하는 목록. 작업공간 목록 화면의 기본이다."
    },
    {
      "name": "Tabs",
      "group": "Navigation",
      "summary": "한 목록을 상태별로 나눠 볼 때 쓴다(학생 목록: 전체 · 승인 · 대기 · 탈퇴, 강좌 관리: 과목별)."
    },
    {
      "name": "TeacherList",
      "group": "Data",
      "summary": "관리자 선생님 목록 표. 사람 목록의 기준 화면이다."
    },
    {
      "name": "Toast",
      "group": "Feedback",
      "summary": "동작이 끝났다는 것을 화면 아래 가운데에 잠깐 알린다."
    },
    {
      "name": "Toolbar",
      "group": "Filters",
      "summary": "목록 바로 위에서 검색 · 거르기 · 개수를 한 줄에 모은다."
    },
    {
      "name": "Topbar",
      "group": "Layout",
      "summary": "작업공간 맨 위 고정 줄: 브랜드, 학기, 알림, 계정."
    }
  ],
