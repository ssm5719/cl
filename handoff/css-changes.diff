+.cl-vplayer__vol-range { position: relative; width: 0; height: 4px; overflow: hidden; border-radius: var(--cl-radius-pill); background: var(--cl-player-vol-track); transition: width var(--cl-dur) var(--cl-ease), margin var(--cl-dur) var(--cl-ease); }
+.cl-vplayer__vol-level { position: absolute; left: 0; top: 0; bottom: 0; border-radius: var(--cl-radius-pill); background: var(--cl-on-ink); }
+.cl-vplayer__volume:hover .cl-vplayer__vol-range, .cl-vplayer__volume:focus-within .cl-vplayer__vol-range { width: 72px; margin: 0 8px 0 4px; }
+.cl-vplayer__time { margin-left: 8px; font-size: var(--cl-fs-13); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.cl-vplayer__time span { color: var(--cl-player-text-2); }
+/* 배속 — 글자 버튼 + 위로 열리는 목록 */
+.cl-vplayer__speed { position: relative; }
+.cl-vplayer__speed-btn { height: 32px; min-width: 52px; padding: 0 10px; border: 0; border-radius: var(--cl-radius-pill); background: var(--cl-player-hover); color: var(--cl-on-ink); font: inherit; font-size: var(--cl-fs-13); font-weight: 600; font-variant-numeric: tabular-nums; cursor: pointer; }
+.cl-vplayer__speed-btn:hover, .cl-vplayer__speed-btn[aria-expanded="true"] { background: var(--cl-player-line); }
+.cl-vplayer__menu { position: absolute; right: 0; bottom: calc(100% + 8px); min-width: 120px; margin: 0; padding: 6px; border-radius: var(--cl-radius-sm); background: var(--cl-player-panel); box-shadow: var(--cl-shadow-float); }
+.cl-vplayer__menu[hidden] { display: none; }
+.cl-vplayer__menu p { margin: 4px 10px 6px; font-size: var(--cl-fs-12); color: var(--cl-player-text-3); }
+.cl-vplayer__menu button { width: 100%; height: 34px; padding: 0 10px; border: 0; border-radius: var(--cl-radius-2xs); background: none; color: var(--cl-on-ink); display: flex; align-items: center; justify-content: space-between; font: inherit; font-size: var(--cl-fs-14); font-variant-numeric: tabular-nums; cursor: pointer; }
+.cl-vplayer__menu button:hover { background: var(--cl-player-hover-soft); }
+.cl-vplayer__menu button[aria-checked="true"] { color: var(--cl-primary-on-dark); font-weight: 600; }
+/* 좁은 플레이어(휴대폰 · 좁은 칸) — 화면 폭이 아니라 플레이어 폭 기준 */
+@container (max-width: 520px) {
+  .cl-vplayer__bar { padding: 24px 4px 4px; }
+  .cl-vplayer__btn { width: 36px; height: 36px; }
+  .cl-vplayer__btn--jump, .cl-vplayer__vol-range { display: none; }
+  .cl-vplayer__time { margin-left: 4px; font-size: var(--cl-fs-12); }
+}
+@media (prefers-reduced-motion: reduce) { .cl-vplayer__bar, .cl-vplayer__track, .cl-vplayer__buffer, .cl-vplayer__played, .cl-vplayer__thumb, .cl-vplayer__tip, .cl-vplayer__vol-range { transition: none; } }
