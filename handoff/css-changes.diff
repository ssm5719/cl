+:is(tr, li, .cl-row):is(:hover, :focus-within) .cl-reveal, .cl-reveal:focus-visible { opacity: 1; }
+@media (hover: none) { .cl-reveal { opacity: 1; } }
+@media (prefers-reduced-motion: reduce) { .cl-reveal { transition: none; } }
+
+/* ---------- 줄 탭 (공개 화면 · 오른쪽 칸 머리) ---------- */
+/* 기본 탭과 같은 구조, 고른 탭 밑줄만 보라 2px · 탭 사이 24 · 글자 15 */
+.cl-tabs--line { gap: 24px; border-bottom-color: var(--cl-hairline); overflow: visible; }
+.cl-tabs--line .cl-tab { position: relative; padding: 0; border-bottom: 0; font-size: var(--cl-fs-body-sm-pub); font-weight: 500; }
+.cl-tabs--line .cl-tab[aria-selected="true"] { font-weight: 600; }
+.cl-tabs--line .cl-tab[aria-selected="true"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; border-radius: var(--cl-radius-3xs); background: var(--cl-primary); }
+
+/* ---------- 짧은 입력 (질문 · 댓글 빠르게 쓰기) ---------- */
+/* 3줄(88)부터 글에 맞춰 늘어나는 입력칸 + 아래 한 줄 [보조 링크 … 취소 · 등록] */
+.cl-composer { display: flex; flex-direction: column; gap: 12px; }
+.cl-composer[hidden] { display: none; }
+.cl-composer__input { width: 100%; box-sizing: border-box; min-height: 88px; max-height: 180px; padding: 12px 14px; border: 1px solid var(--cl-control-border); border-radius: var(--cl-radius-control); background: var(--cl-canvas); color: var(--cl-ink); font: inherit; font-size: var(--cl-fs-ui); line-height: 1.6; resize: none; field-sizing: content; }
+.cl-composer__input::placeholder { color: var(--cl-ink-faint); }
+.cl-composer__input:focus { outline: none; border-color: var(--cl-primary); box-shadow: 0 0 0 3px var(--cl-primary-tint); }
+.cl-composer__row { display: flex; align-items: center; gap: 8px; }
+.cl-composer__more { margin-right: auto; display: inline-flex; align-items: center; gap: 4px; font-size: var(--cl-fs-caption); color: var(--cl-ink-muted); text-decoration: none; }
+.cl-composer__more:hover { color: var(--cl-ink); text-decoration: underline; text-underline-offset: 3px; }
+.cl-composer__done { margin: 12px 0 0; font-size: var(--cl-fs-caption); color: var(--cl-success); }
+
+/* ---------- 작은 목록 (오른쪽 칸 · 작은 창 안) ---------- */
+/* 줄마다 [배지 64 | 제목 / 정보], 줄 사이 선. --plain 은 배지 없이 */
+.cl-mini-list { margin: 0; padding: 0; list-style: none; }
+.cl-mini-list__item { display: grid; grid-template-columns: 64px minmax(0, 1fr); column-gap: 12px; row-gap: 6px; padding: 16px 20px; border-bottom: 1px solid var(--cl-hairline); color: var(--cl-ink); text-decoration: none; }
+.cl-mini-list__item:hover { background: var(--cl-row-hover); }
+.cl-mini-list__item > .cl-badge { grid-row: 1 / span 2; align-self: start; justify-content: center; width: 64px; box-sizing: border-box; }
+.cl-mini-list--plain .cl-mini-list__item { grid-template-columns: minmax(0, 1fr); }
+.cl-mini-list__title { font-size: var(--cl-fs-ui); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cl-mini-list__meta { font-size: var(--cl-fs-caption); color: var(--cl-ink-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cl-mini-list__mark { color: var(--cl-primary-pressed); font-weight: 500; }
+.cl-mini-list__foot { display: flex; align-items: center; justify-content: center; gap: 4px; padding: 16px 20px; font-size: var(--cl-fs-caption); color: var(--cl-ink-muted); text-decoration: none; }
+.cl-mini-list__foot:hover { color: var(--cl-ink); text-decoration: underline; text-underline-offset: 3px; }
+
+/* ---------- 작은 창 더하기 · 사람 카드 · 링크 목록 ---------- */
+/* 여는 버튼 왼쪽 끝에 맞춰 열리는 카드형 작은 창 (선생님 작은 창 등) */
+.cl-popover--inline { display: inline-flex; }
+.cl-popover__panel--start { left: 0; right: auto; }
+.cl-popover__panel--card { top: calc(100% + 8px); z-index: 30; width: 320px; max-width: calc(100vw - 40px); box-sizing: border-box; padding: 20px; border-radius: var(--cl-radius-sm); }
+.cl-popover__panel[hidden] { display: none; }
+.cl-popover__panel--card > .cl-btn--block { margin-top: 16px; }
+/* 사람 — [사진 | 이름 / 과목] */
+.cl-person { display: flex; align-items: center; gap: 12px; min-width: 0; }
+.cl-person__name { margin: 0; font-size: var(--cl-fs-body-sm-pub); font-weight: 600; color: var(--cl-ink); }
+.cl-person__sub { margin: 2px 0 0; font-size: var(--cl-fs-caption); color: var(--cl-ink-muted); }
+/* 작은 제목 — '담당 강좌 5' 처럼 목록 위 회색 머리 */
+.cl-subhead { margin: 20px 0 8px; display: flex; align-items: center; gap: 6px; font-size: var(--cl-fs-caption); font-weight: 500; color: var(--cl-ink-muted); }
+/* 선으로 나눈 링크 목록 — 한 줄 말줄임, 오른쪽에 배지 하나 */
+.cl-link-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--cl-hairline); }
+.cl-link-list__item { display: flex; align-items: center; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--cl-hairline); font-size: var(--cl-fs-ui); color: var(--cl-ink); text-decoration: none; }
+.cl-link-list__text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cl-link-list__item:hover .cl-link-list__text { color: var(--cl-primary-pressed); }
+
+/* ---------- 사진 없는 사람 · 아바타 크기 ---------- */
+/* 사진이 없을 때 — 연보라 원 가운데 선 사람 아이콘(img/teacher-placeholder.svg, 60%) */
+.cl-avatar--ph { background: var(--cl-primary-wash); color: var(--cl-primary); overflow: hidden; box-sizing: border-box; }
+.cl-avatar--ph > svg { width: 60%; height: 60%; margin-top: -4%; }
+.cl-avatar--md { width: 32px; height: 32px; }
+.cl-avatar--lg { width: 44px; height: 44px; }
+.cl-avatar--fill { width: 100%; height: 100%; }
+
+/* ---------- 빈 상태 · 점선 상자 (학원 공개 화면) ---------- */
+/* 회색 점선 1px · 모서리 8 · 바탕 없음. 목록 자리 최소 240. --sm 은 댓글 · 답변처럼 작은 자리 */
+.cl-empty--line { min-height: 240px; box-sizing: border-box; justify-content: center; padding: 48px 20px; border: 1px dashed var(--cl-control-border); border-radius: var(--cl-radius-sm); color: var(--cl-ink-muted); }
+.cl-empty--line > .cl-icon { color: var(--cl-ink-faint); margin-bottom: 4px; }
+.cl-empty--line .cl-empty__title { font-size: var(--cl-fs-body-sm-pub); font-weight: 500; color: var(--cl-ink-muted); }
+.cl-empty--line .cl-empty__desc { font-size: var(--cl-fs-caption); color: var(--cl-ink-faint); }
+.cl-empty--sm { min-height: 0; padding: 32px 20px; }
+.cl-empty--sm > .cl-icon { width: 24px; height: 24px; }
+
+/* ---------- 파일 카드 · 문서 보기 ---------- */
+/* 미리보기가 안 되는 파일(한글 · 워드 · PPT) — [파일 아이콘 + 종류] / 이름 / 종류 · 쪽수 · 크기 / [내려받기][새 창으로 열기] */
+.cl-filecard { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 24px; text-align: center; }
+.cl-filecard__icon { position: relative; width: 64px; height: 64px; margin-bottom: 8px; display: grid; place-items: center; border-radius: var(--cl-radius-sm); background: var(--cl-canvas); color: var(--cl-ink-muted); box-shadow: inset 0 0 0 1px var(--cl-hairline); }
+.cl-filecard__ext { position: absolute; right: -6px; bottom: -6px; height: 20px; padding: 0 6px; display: inline-grid; place-items: center; border-radius: var(--cl-radius-xs); background: var(--cl-primary); color: var(--cl-on-ink); font-style: normal; font-size: var(--cl-fs-micro); font-weight: 600; letter-spacing: .02em; }
+.cl-filecard__name { margin: 0; font-size: var(--cl-fs-body-public); font-weight: 600; color: var(--cl-ink); word-break: keep-all; }
+.cl-filecard__meta { margin: 0; font-size: var(--cl-fs-caption); color: var(--cl-ink-muted); }
+.cl-filecard__actions { margin-top: 16px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
+.cl-filecard__actions .cl-btn { height: var(--cl-h-control-lg); padding: 0 16px; }
+.cl-filecard__actions .cl-btn--ghost { background: var(--cl-canvas); }
+/* 문서 바로 보기 칸(PDF) — 먹색 머리 줄 + 회색 바탕 위 쪽들. 실제는 브라우저 PDF 보기(iframe) */
+.cl-docview { display: flex; flex-direction: column; background: var(--cl-disabled-bg); }
+.cl-docview__bar { flex: none; height: 44px; padding: 0 16px; display: flex; align-items: center; gap: 12px; background: var(--cl-surface-dark); color: var(--cl-on-ink-2); font-size: var(--cl-fs-caption); }
+.cl-docview__name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
+.cl-docview__tools { display: inline-flex; align-items: center; gap: 10px; color: var(--cl-control-border); }
+.cl-docview__sep { width: 1px; height: 16px; background: rgba(255, 255, 255, .2); }
+.cl-docview__pages { flex: 1; overflow: auto; display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 24px; }
+.cl-docview__page { flex: none; width: min(62%, 520px); aspect-ratio: 210 / 297; box-sizing: border-box; padding: 8% 7%; display: flex; flex-direction: column; gap: 10px; background: var(--cl-canvas); box-shadow: 0 1px 3px rgba(0, 0, 0, .12); }
+
+
+/* ---------- 동영상 플레이어 조작 줄 (VideoPlayer) ----------
+   실제 플레이어는 별도 서비스(LABY 플레이어 · cms.atedu.co.kr)라 이 CSS 를 불러오지 않는다. 플레이어 담당은 이 규칙의 값을 옮겨 쓴다.
+   클래스 대응: .cl-vplayer = #player-wrap · __bar = #player-footer · __seek = .progress-gage-wrap · __controls = .player-controller-box (NL1) */
+.cl-vplayer { container-type: inline-size; position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--cl-radius-sm); background: var(--cl-player-bg); color: var(--cl-on-ink); font-family: var(--cl-font); user-select: none; }
+.cl-vplayer__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
+/* 멈췄을 때 가운데 큰 재생 버튼 */
+.cl-vplayer__center { position: absolute; left: 50%; top: 50%; width: 72px; height: 72px; margin: -36px 0 0 -36px; border: 0; border-radius: var(--cl-radius-pill); background: var(--cl-player-center); color: var(--cl-on-ink); display: none; place-items: center; cursor: pointer; }
+.cl-vplayer[data-state="paused"] .cl-vplayer__center { display: grid; }
+.cl-vplayer__center svg { width: 32px; height: 32px; } /* 삼각형 무게중심이 원 가운데에 오게 — 따로 밀지 않는다 */
+/* 조작 줄 — 영상 위 아래쪽 그라데이션. 재생 중 3초 가만히 · 밖으로 나가면 .is-idle 로 바로 페이드아웃 */
+.cl-vplayer__bar { position: absolute; left: 0; right: 0; bottom: 0; padding: 32px 12px 8px; background: linear-gradient(to bottom, transparent, var(--cl-player-scrim)); transition: opacity 250ms var(--cl-ease); }
+.cl-vplayer.is-idle .cl-vplayer__bar { opacity: 0; pointer-events: none; }
+.cl-vplayer.is-idle { cursor: none; }
+/* 진행 막대 — 버튼 위. 누르는 높이 16 · 막대 4(올리면 6) · 본 부분 학원 대표색 · 손잡이 14 · 시간 말풍선 */
+.cl-vplayer__seek { position: relative; height: 16px; margin: 0 4px; cursor: pointer; }
+.cl-vplayer__track, .cl-vplayer__buffer, .cl-vplayer__played { position: absolute; left: 0; top: 50%; height: 4px; margin-top: -2px; border-radius: var(--cl-radius-pill); transition: height var(--cl-dur) var(--cl-ease), margin var(--cl-dur) var(--cl-ease); }
+.cl-vplayer__track { right: 0; background: var(--cl-player-line); }
+.cl-vplayer__buffer { background: var(--cl-player-buffer); }
+.cl-vplayer__played { background: var(--cl-primary); }
+.cl-vplayer__seek:hover :is(.cl-vplayer__track, .cl-vplayer__buffer, .cl-vplayer__played), .cl-vplayer__seek:focus-visible :is(.cl-vplayer__track, .cl-vplayer__buffer, .cl-vplayer__played) { height: 6px; margin-top: -3px; }
+.cl-vplayer__thumb { position: absolute; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: var(--cl-radius-pill); background: var(--cl-on-ink); box-shadow: var(--cl-player-thumb-shadow); transform: scale(0); transition: transform var(--cl-dur) var(--cl-ease); }
+.cl-vplayer__seek:hover .cl-vplayer__thumb, .cl-vplayer__seek:focus-visible .cl-vplayer__thumb { transform: scale(1); }
+.cl-vplayer__tip { position: absolute; bottom: 20px; transform: translateX(-50%); padding: 2px 8px; border-radius: var(--cl-radius-2xs); background: var(--cl-player-tip); font-size: var(--cl-fs-12); font-variant-numeric: tabular-nums; opacity: 0; pointer-events: none; transition: opacity var(--cl-dur) var(--cl-ease); }
+.cl-vplayer__seek:hover .cl-vplayer__tip, .cl-vplayer__seek:focus-visible .cl-vplayer__tip { opacity: 1; }
+/* 버튼 줄 — 누르는 칸 40 · 아이콘 22 · 올리면 흰 14% 원 */
+.cl-vplayer__controls { height: 44px; display: flex; align-items: center; gap: 2px; }
+.cl-vplayer__spacer { flex: 1; }
+.cl-vplayer__btn { width: 40px; height: 40px; flex: none; padding: 0; border: 0; border-radius: var(--cl-radius-pill); background: transparent; color: var(--cl-on-ink); display: grid; place-items: center; cursor: pointer; transition: background var(--cl-dur) var(--cl-ease); }
+.cl-vplayer__btn:hover { background: var(--cl-player-hover); }
+.cl-vplayer__btn svg { width: 22px; height: 22px; }
+/* 음량 — 스피커를 누르면 음소거(aria-pressed), 막대는 올리거나 키보드로 들어갈 때만 펼침 */
