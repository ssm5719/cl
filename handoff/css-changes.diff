+[aria-selected="true"] > .cl-count, .cl-count--active { background: var(--cl-primary-tint); color: var(--cl-primary-pressed); }
+/* 점 + 글자 상태 — 표 안 '승인 · 대기 · 꺼짐'. 배지보다 조용하게 */
