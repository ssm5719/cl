+/* ---------- 버튼 종류 더하기 ---------- */
+/* 옅은 회색 — 공개 화면 보조 동작(공유 · 좋아요 · 더보기 · 분류 알약). 회색 판 위에서는 흰색 */
+.cl-btn--soft { background: var(--cl-parchment); color: var(--cl-ink); }
+.cl-btn--soft:hover { background: var(--cl-hover); }
+.is-alt .cl-btn--soft, .cl-btn--soft.on-gray { background: var(--cl-canvas); }
+/* 먹색 — 공개 화면 머리의 주 동작(로그인 등) */
+.cl-btn--dark { background: var(--cl-ink); color: var(--cl-on-ink); }
+.cl-btn--dark:hover { background: var(--cl-surface-dark-hover); }
+/* 흰 바탕 + 연보라 테두리 + 보라 글자 — 연보라 판 위의 작은 동작(이 강의 질문하기) */
+.cl-btn--line { background: var(--cl-canvas); color: var(--cl-primary-pressed); box-shadow: inset 0 0 0 1px var(--cl-primary-line); font-weight: 500; }
+.cl-btn--line:hover { background: var(--cl-canvas); box-shadow: inset 0 0 0 1px var(--cl-primary); }
+/* 크기 — 기본 32 · sm 28 · xs 26 에 더해 md 36 · lg 44(터치) · xl 48 */
+.cl-btn--md { height: 36px; padding: 0 14px; font-size: var(--cl-fs-ui); font-weight: 500; }
+.cl-btn--xl { height: 48px; padding: 0 22px; font-size: var(--cl-fs-body-public); }
+.cl-btn--block { display: flex; width: 100%; }
+/* 떠 있는 흰 버튼 — 회색 판 위 '분류 더보기' 처럼 목록 끝에 하나만 */
+.cl-btn--float { background: var(--cl-canvas); color: var(--cl-ink); box-shadow: var(--cl-shadow-float); }
+.cl-btn--float:hover { background: var(--cl-hover); }
+/* 진한 판 위 — 투명 바탕 · 흰 테두리 · 흰 글자 */
+.cl-btn--on-dark, .cl-btn--on-dark:hover { background: transparent; color: var(--cl-on-ink); box-shadow: inset 0 0 0 1px var(--cl-on-ink); }
+/* 버튼 끝 화살표 — 올리면 4px 앞으로 */
+.cl-btn__arrow { flex: none; transition: transform var(--cl-dur) var(--cl-ease); }
+.cl-btn:hover .cl-btn__arrow { transform: translateX(4px); }
+@media (prefers-reduced-motion: reduce) { .cl-btn__arrow { transition: none; } .cl-btn:hover .cl-btn__arrow { transform: none; } }
+
+/* 아이콘 버튼 — 둥근 모양 · 회색 바탕 · 크기 */
+.cl-icon-btn--round { border-radius: var(--cl-radius-pill); }
+/* 켜고 끄는 아이콘 버튼(화면 테마 해 · 달 등) — 고른 것은 연보라 바탕 · 진한 보라 아이콘 */
+.cl-icon-btn[aria-pressed="true"], .cl-icon-btn[aria-pressed="true"]:hover { background: var(--cl-primary-tint); color: var(--cl-primary-pressed); }
+.cl-icon-btn--soft { background: var(--cl-parchment); color: var(--cl-ink); }
+.cl-icon-btn--soft:hover { background: var(--cl-primary-tint); color: var(--cl-primary-pressed); }
+.cl-icon-btn--soft:disabled { background: var(--cl-parchment); color: var(--cl-ink-faint); opacity: 1; }
+.cl-icon-btn--xs { width: 26px; height: 26px; }
+.cl-icon-btn--md { width: 36px; height: 36px; }
+.cl-icon-btn--lg { width: 44px; height: 44px; }
+/* 진한 판 위 — 흰 12% 원, 올리면 20% */
+.cl-icon-btn--on-dark { background: rgba(255, 255, 255, .12); color: var(--cl-on-ink); }
+.cl-icon-btn--on-dark:hover { background: rgba(255, 255, 255, .2); }
+
+/* ---------- 글자 링크 ---------- */
+/* 본문 속 동작 링크 — 평소 밑줄 없음, 올리면 밑줄. --muted 회색에서 보라로, --danger 빨강(비밀번호 초기화 등) */
+.cl-link { display: inline-flex; align-items: center; gap: 4px; padding: 0; border: 0; background: none; font: inherit; font-weight: 600; color: var(--cl-primary-pressed); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; cursor: pointer; }
