+.cl-status--wait::before { width: 7px; height: 7px; background: transparent; box-shadow: inset 0 0 0 1.5px currentColor; }
+.cl-status--off { color: var(--cl-ink-muted); }
+/* 지울 수 있는 칩 — 추천 키워드 등. 칩을 눌러도 지워지지 않고 ✕ 만 지운다 */
+.cl-tag { height: 30px; padding: 0 4px 0 12px; display: inline-flex; align-items: center; gap: 2px; border-radius: var(--cl-radius-pill); background: var(--cl-hover); color: var(--cl-ink); font-size: var(--cl-fs-ui); }
+.cl-tag__x { width: 24px; height: 24px; border: 0; border-radius: var(--cl-radius-pill); background: transparent; color: var(--cl-ink-muted); display: grid; place-items: center; cursor: pointer; }
