+.cl-link--danger:hover { color: var(--cl-danger-pressed); }
+/* 더보기 › — 글자 크기는 놓인 자리를 따른다 */
+.cl-more-link { display: inline-flex; align-items: center; gap: 2px; font-weight: 600; color: var(--cl-primary-pressed); text-decoration: none; white-space: nowrap; }
+.cl-more-link:hover { text-decoration: underline; text-underline-offset: 3px; }
+
+/* ---------- 숫자 알약 · 상태 점 · 지울 수 있는 칩 ---------- */
